{
  "name": "fitlog",
  "version": "1.3.0",
  "private": true,
  "description": "FitLog 练迹 · 以训练记录为地基、以图文视频内容为表达方式的个人健身成长档案",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/run-with-jdk21.mjs mvn -f backend/pom.xml spring-boot:run",
    "dev:frontend": "vite",
    "dev:admin": "vite --config frontend/admin/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend && npm run build:admin",
    "build:backend": "node scripts/run-with-jdk21.mjs mvn -f backend/pom.xml -DskipTests package",
    "build:frontend": "vite build",
    "build:admin": "vite build --config frontend/admin/vite.config.ts",
    "start": "node scripts/run-with-jdk21.mjs java -jar backend/target/fitlog-backend-1.3.0.jar",
    "db:init": "node scripts/init-mysql.mjs",
    "smoke": "node --test tests/smoke.test.mjs",
    "smoke:ui": "node tests/ui-check.mjs",
    "smoke:ops": "node tests/ops-ui-check.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p frontend/admin/tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "mysql2": "^3.15.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
